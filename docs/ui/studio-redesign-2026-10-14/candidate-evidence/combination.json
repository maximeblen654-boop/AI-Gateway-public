      ],
      "depends_on": {
        "core": {
          "condition": "service_healthy"
        }
      }
    },
    "bridge": {
      "image": "native-candidate-bridge:b2fcdac93afa6ae194ee81801a9b37813f8f39eb",
      "network_mode": "service:core",
      "volumes": [
        "native_core_20261012:/app/data:ro"
      ],
      "depends_on": {
        "core": {
          "condition": "service_healthy"
        }
      }
    },
    "bff": {
      "image": "native-candidate-bff:b2fcdac93afa6ae194ee81801a9b37813f8f39eb",
      "network_mode": "service:core",
      "volumes": [
        "native_assets_20261012:/state/assets",
        "native_images_20261012:/state/images",
        "native_videos_20261012:/state/videos"
      ],
      "depends_on": {
